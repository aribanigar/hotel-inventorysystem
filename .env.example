NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres@localhost:5432/hotel_inventory
DB_POOL_MAX=20

# How long a "Proceed to Pay" hold keeps the room (seconds). 600 = 10 minutes.
HOLD_TTL_SECONDS=600
# Run the hold-expiry sweeper and outbox worker inside the API process.
# Set to false in production and run `npm run start:worker` as its own process.
RUN_JOBS_IN_PROCESS=true

# Source 1: external B2B supplier (TBO / Tripjack style). Point at the mock in dev.
SUPPLIER_BASE_URL=http://localhost:4100
SUPPLIER_API_KEY=dev-supplier-key
SUPPLIER_TIMEOUT_MS=8000

# Inbound channel-manager webhooks: allowed clock skew for signed requests.
WEBHOOK_MAX_SKEW_SECONDS=300

# Extranet (houseboats / boutique stays) admin token, at least 24 chars.
EXTRANET_ADMIN_TOKEN=change-me-to-a-long-random-string

# Payments: "mock" for local dev, "razorpay" in production.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
